{
  // Known handhelds. Used only for nicer names and wizard hints:
  // the screen is always detected live and buttons are always confirmed
  // by the setup wizard, so unknown devices work too.
  //
  // match: case-insensitive regexes (all optional) against
  //   manufacturer = Build.MANUFACTURER, model = Build.MODEL,
  //   controller = name of the built-in InputDevice
  // faceLayout: "nintendo" (A on the right, B at the bottom) or "xbox" (A at the bottom)
  //
  // Known devices skip the button wizard: the launcher assumes each button sends
  // the keycode matching its printed label and assigns Confirm=A, Cancel=B,
  // Run=left face button, Registered item=top face button, Speed up=R1, Save=L1,
  // list up/down=L2/R2. If a device sends different keycodes, add an explicit
  //   "mapping": { "C": "BUTTON_A", "B": "BUTTON_B", "A": "BUTTON_Y", "R": "BUTTON_R1",
  //                "L": "BUTTON_L1", "Z": "BUTTON_X", "X": "BUTTON_L2", "Y": "BUTTON_R2" }
  // (RGSS input -> Android keycode). Players can always re-map with "Configure buttons".
  //
  // PRs welcome: add your device here.
  "devices": [
    { "name": "Retroid Pocket Nova",    "match": { "model": "pocket ?nova" },      "faceLayout": "nintendo",
      "notes": "4:3 1280x960 AMOLED screen, 120 Hz" },
    { "name": "Retroid Pocket 5",       "match": { "model": "pocket ?5" },         "faceLayout": "nintendo" },
    { "name": "Retroid Pocket Mini",    "match": { "model": "pocket ?mini" },      "faceLayout": "nintendo" },
    { "name": "Retroid Pocket Flip 2",  "match": { "model": "flip ?2" },           "faceLayout": "nintendo" },
    { "name": "Retroid Pocket Classic", "match": { "model": "pocket ?classic" },   "faceLayout": "nintendo" },
    { "name": "Retroid Pocket 4 Pro",   "match": { "model": "pocket ?4 ?pro" },    "faceLayout": "nintendo" },
    { "name": "Retroid Pocket 4",       "match": { "model": "pocket ?4" },         "faceLayout": "nintendo" },
    { "name": "Retroid Pocket",         "match": { "manufacturer": "retroid|moorechip" }, "faceLayout": "nintendo" },

    { "name": "AYN Odin 2",             "match": { "model": "odin ?2" },           "faceLayout": "xbox" },
    { "name": "AYN Thor",               "match": { "model": "thor" },              "faceLayout": "xbox" },
    { "name": "AYN Odin",               "match": { "manufacturer": "ayn" },        "faceLayout": "xbox" },

    { "name": "Anbernic RG556",         "match": { "model": "rg ?556" },           "faceLayout": "nintendo" },
    { "name": "Anbernic RG406",         "match": { "model": "rg ?406" },           "faceLayout": "nintendo" },
    { "name": "Anbernic RG Cube",       "match": { "model": "rg ?cube" },          "faceLayout": "nintendo" },
    { "name": "Anbernic",               "match": { "manufacturer": "anbernic" },   "faceLayout": "nintendo" },

    { "name": "AYANEO Pocket",          "match": { "manufacturer": "ayaneo" },     "faceLayout": "xbox" }
  ]
}
