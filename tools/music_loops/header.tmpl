/* Loop points for music that was recorded as "intro + loop + loop + fade out" (or with silence
 * at its end) and carries no LOOPSTART / LOOPLENGTH tags, so it would otherwise be heard to end,
 * go quiet and start again.
 *
 * Generated by tools/music_loops (see its README); do not edit by hand.
 * A track is recognised by its exact length in PCM frames, so nothing here can apply to any other
 * file. Each row: total frames, loop start, loop length (frames at the file's own rate).
 * A loop start of 0 means "the whole track, without the silence at its end". */

#ifndef ASHDROID_LOOPS_H
#define ASHDROID_LOOPS_H

#include <stdint.h>

struct AshDroidLoop
{
	uint32_t total;
	uint32_t start;
	uint32_t length;
};

/* Sorted by total */
static const AshDroidLoop ashdroidLoops[] =
{
@ROWS@};

static const int ashdroidLoopCount = sizeof(ashdroidLoops) / sizeof(ashdroidLoops[0]);

/* Binary search by total length; 0 when the track is not in the table */
static inline const AshDroidLoop *ashdroidFindLoop(int64_t total)
{
	int lo = 0, hi = ashdroidLoopCount - 1;

	if (total <= 0)
		return 0;

	while (lo <= hi)
	{
		int mid = lo + (hi - lo) / 2;
		int64_t t = ashdroidLoops[mid].total;

		if (t == total)
			return &ashdroidLoops[mid];

		if (t < total)
			lo = mid + 1;
		else
			hi = mid - 1;
	}

	return 0;
}

#endif /* ASHDROID_LOOPS_H */
